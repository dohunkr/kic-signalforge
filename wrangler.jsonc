{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kic-signalforge",
  "main": "src/index.js",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./app/web/static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "containers": [
    {
      "class_name": "SignalForgeContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNALFORGE",
        "class_name": "SignalForgeContainer"
      }
    ]
  },
  "exports": {
    "SignalForgeContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
