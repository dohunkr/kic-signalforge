# ==========================================================================
# KIC SignalForge - 환경변수 예시
# 이 파일은 '실제 값'이 들어가지 않는 템플릿입니다. 실제 키는 .env 에 넣고
# .env 는 .gitignore 에 포함되어 있으므로 저장소에 올라가지 않습니다.
# 복사:  cp .env.example .env
# ==========================================================================

# --- NVIDIA NIM (LLM 추론) ---------------------------------------------
# 발급: https://build.nvidia.com/settings
# 기본 엔드포인트(공식): https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# 기본 모델. 2026-10-21 실측으로 이 계정에서 실제 호출이 확인된 모델입니다.
# (/v1/models 목록에 있어도 계정에 프로비저닝되지 않으면 404가 나므로
#  앱이 자동으로 실제 호출 가능한 모델을 찾아 대체합니다.)
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_TIMEOUT_SECONDS=45

# --- 금융감독원 OpenDART (기업 공시) ------------------------------------
# 발급: https://opendart.fss.or.kr -> 회원가입 -> 인증키 신청/관리
DART_API_KEY=

# --- 한국은행 ECOS (거시통계) --------------------------------------------
# 발급: https://ecos.bok.or.kr/api/ -> 회원가입 -> OPEN API 인증키 신청
# 비워두면 'sample' 키로 동작합니다(공식 샘플 키, 일부 통계만 제공).
ECOS_API_KEY=

# --- 국가데이터처 KOSIS (산업/국가통계) ----------------------------------
# 발급: https://kosis.kr/openapi/ -> 회원가입 -> 활용신청
KOSIS_API_KEY=

# --- 서버 ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# 세션 저장 위치 (SQLite). 상대경로면 프로젝트 루트의 data/ 아래에 생성됩니다.
KIC_DATA_DIR=./data
# 리서치 1회 최대 wall-clock 시간(초)
KIC_MAX_RUN_SECONDS=90
# 커넥터별 재시도 횟수
KIC_MAX_RETRIES=2
# 만료로 경고할 문서 기준 일수
KIC_STALE_AFTER_DAYS=400
# 로그 레벨: DEBUG / INFO / WARNING / ERROR
KIC_LOG_LEVEL=INFO
